{
  "compilerOptions": {
    "target": "es5",
    "module": "esnext",
    "lib": ["es2015", "dom"],
    "allowJs": true,
    "checkJs": true,
    "baseUrl": "./",
    "paths": {
      "vue-i18n": ["node_modules/vue-i18n/dist/vue-i18n.cjs.js"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue", "src/**/*.js"]
}